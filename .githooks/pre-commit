#!/bin/sh
# Pre-commit hook — bloqueia dados pessoais antes de qualquer commit.
# Instalação: sh setup.sh  (uma vez após clonar)
#
# Lógica de detecção vive em scripts/scan-dados-pessoais.sh -- fonte única,
# compartilhada com o GitHub Action que roda o mesmo scan server-side.
# Nunca duplicar o padrão aqui.

STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

sh "$(git rev-parse --show-toplevel)/scripts/scan-dados-pessoais.sh" $STAGED
